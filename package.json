{
  "name": "tools-webapp",
  "private": true,
  "version": "1.0.0",
  "description": "Volta Link — Clean Architecture URL shortener monorepo",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
